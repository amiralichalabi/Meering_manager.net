<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MeetingManager</RootNamespace>
    <AssemblyName>MeetingManager</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="Assets\fonts\*.ttf" LogicalName="font.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
